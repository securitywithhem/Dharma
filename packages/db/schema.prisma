generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model Plan {
  id               String   @id @default(cuid())
  name             String   @unique // "free", "pro", "enterprise"
  displayName      String   // "Free", "Pro", "Enterprise"
  stripePriceId    String?  // null for free tier
  price            Float    @default(0) // monthly price in USD
  limits           Json     // { users: 5, frameworks: 3, storageMb: 100 }
  features         Json?    // { apiAccess: false, sso: false, ...}
  isPublic         Boolean  @default(true)
  createdAt        DateTime @default(now())
  organizations    Organization[]
  
  @@index([name])
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  users        User[]
  frameworks   Framework[]
  evidences    Evidence[]
  policies     Policy[]
  auditLogs    AuditLog[]
  auditorKeys  AuditorAccess[]
  invites      OrganizationInvite[]
  chainAnchors ChainAnchor[]
  connectors   Connector[]
  auditExports AuditExport[]
  importedItems ImportedItem[]

  // Phase 2 Feature 1: per-org AI provider config
  // mode: 'local-ollama' | 'local-small' | 'remote-opt-in'
  // stored as encrypted JSON blob
  aiProvider   Json?

  // Billing and Subscription (Phase 3)
  planId               String?
  plan                 Plan?           @relation(fields: [planId], references: [id])
  stripeCustomerId     String?         @unique
  stripeSubscriptionId String?         @unique
  subscriptionStatus   SubscriptionStatus? @default(ACTIVE)
  subscriptionEndsAt   DateTime?

  // 64-bit unique lock ID for safe pg_advisory_xact_lock calls
  lockKeyId    BigInt               @unique @default(autoincrement())

  @@index([createdAt])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String?
  image          String?
  emailVerified  DateTime?
  role           Role          @default(VIEWER)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts       Account[]
  sessions       Session[]
  auditLogs      AuditLog[]
  marketplaceItems MarketplaceItem[] @relation("MarketplaceItemAuthor")
  marketplaceReviews MarketplaceReview[] @relation("MarketplaceReviews")

  @@index([organizationId])
  @@index([email])
}

enum Role {
  ADMIN
  COMPLIANCE_MANAGER
  VIEWER
  PUBLISHER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Framework {
  id             String       @id @default(cuid())
  name           String
  version        String       @default("1.0")
  description    String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controls            Control[]
  marketplaceSourceId String?
  importedItemId      String?

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Control {
  id          String        @id @default(cuid())
  frameworkId String
  framework   Framework     @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  domain      String
  title       String
  description String        @db.Text
  guidance    String?       @db.Text
  status      ControlStatus @default(NOT_STARTED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  evidence    Evidence[]

  // pgvector embedding for semantic similarity search against Evidence embeddings
  embedding   Unsupported("vector(384)")?

  @@index([frameworkId])
  @@index([domain])
  @@index([status])
}


enum ControlStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  NOT_APPLICABLE
}

model Evidence {
  id             String                @id @default(cuid())
  controlId      String
  control        Control               @relation(fields: [controlId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Phase 2 Feature 2: link back to the connector that auto-created this row
  connectorId    String?
  connector      Connector?            @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  fileName       String
  filePath       String
  fileSizeBytes  Int                   @default(0)
  type           EvidenceType
  summary        String?               @db.Text
  collectedAt    DateTime              @default(now())
  expiresAt      DateTime?
  embedding      Unsupported("vector(384)")?
  embeddingStatus EmbeddingStatus      @default(PENDING)
  embeddingError  String?              @db.Text
  embeddingAttempts Int                @default(0)
  lastEmbeddingAttempt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([controlId])
  @@index([organizationId])
  @@index([type])
  @@index([connectorId])
  @@index([embeddingStatus])
}

enum EvidenceType {
  SCREENSHOT
  POLICY_DOC
  API_RESPONSE
  LOG_EXCERPT
  CERTIFICATE
  OTHER
}

enum EmbeddingStatus {
  PENDING
  SUCCESS
  FAILED
}

model Policy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  content        String       @db.Text
  version        Int          @default(1)
  isPublished    Boolean      @default(false)
  policyType     PolicyType
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([policyType])
}

enum PolicyType {
  PRIVACY_POLICY
  DATA_RETENTION
  ACCESS_CONTROL
  INCIDENT_RESPONSE
  OTHER
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String
  changes        Json?
  timestamp      DateTime     @default(now())
  previousHash   String?
  currentHash    String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([timestamp])
  @@index([userId])
}

model RegulationSnippet {
  id            String                     @id @default(cuid())
  frameworkName String
  sectionNumber String
  content       String                     @db.Text
  embedding     Unsupported("vector(384)")?
  createdAt     DateTime                   @default(now())

  @@index([frameworkName])
}

model AuditorAccess {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String?      @unique
  sessionTokenHash String?    @unique
  expiresAt      DateTime
  isActive       Boolean      @default(true)
  exchangedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([expiresAt])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(VIEWER)
  token          String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
  @@index([expiresAt])
}

// ============================================================
// Phase 2 Feature 3: External Audit Chain Anchors
// ============================================================

model ChainAnchor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rootHash       String
  recordCount    Int
  fromLogId      String
  toLogId        String
  anchoredAt     DateTime     @default(now())
  storageKey     String       // path in ANCHOR_STORAGE_BUCKET
  publicProof    String?      // OpenTimestamps .ots receipt path, or null

  @@index([organizationId])
  @@index([anchoredAt])
}

// ============================================================
// Phase 2 Feature 2: Automated Evidence Connectors
// ============================================================

model Connector {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       ConnectorProvider
  displayName    String
  credentials    String          // AES-256-GCM encrypted at rest
  config         Json            // e.g. { repos: ["org/repo"] } or { regions: ["ap-south-1"] }
  status         ConnectorStatus @default(ACTIVE)
  lastRunAt      DateTime?
  lastRunStatus  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  evidence       Evidence[]      // evidence rows sourced from this connector

  @@unique([organizationId, provider, displayName])
  @@index([organizationId])
}

enum ConnectorProvider {
  GITHUB
  AWS
  VERCEL
}

enum ConnectorStatus {
  ACTIVE
  PAUSED
  ERROR
}

// ============================================================
// Phase 2 Feature 4: Policy Templates
// ============================================================

model PolicyTemplate {
  id           String     @id @default(cuid())
  policyType   PolicyType
  name         String
  version      String
  bodyTemplate String     @db.Text   // Handlebars source with {{placeholders}}
  variables    Json                  // [{ key, label, type, required, defaultValue? }]
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([policyType, name, version])
  @@index([policyType])
}

// ============================================================
// Phase 2 Feature 5: Auditor Export Packages
// ============================================================

model AuditExport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    String       // userId who triggered export
  frameworkIds   Json         // string[]
  filePath       String       // MinIO object key
  includeRawFiles Boolean     @default(false)
  createdAt      DateTime     @default(now())
  expiresAt      DateTime     // presigned URL expiry (24h after creation)

  @@index([organizationId])
  @@index([expiresAt])
}

// ============================================================
// Phase 3c: Marketplace
// ============================================================

enum ItemType {
  FRAMEWORK
  TEMPLATE
  CONNECTOR
}

model MarketplaceItem {
  id              String   @id @default(cuid())
  type            ItemType
  name            String
  slug            String   @unique
  description     String   @db.Text
  shortDescription String? 
  authorId        String   
  author          User     @relation("MarketplaceItemAuthor", fields: [authorId], references: [id])
  
  price           Float    @default(0)
  currency        String   @default("USD")
  
  metadata        Json
  category        String
  tags            String[]
  logo            String?
  coverImage      String?
  
  version         String   @default("1.0.0")
  isPublic        Boolean  @default(false)
  isOfficial      Boolean  @default(false)
  ratings         Float    @default(0)
  reviewCount     Int      @default(0)
  downloads       Int      @default(0)
  
  reviews         MarketplaceReview[]
  importedItems   ImportedItem[]
  revisions       MarketplaceItemRevision[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?
  
  @@index([authorId, isPublic, createdAt])
  @@index([category, isPublic])
}

model MarketplaceReview {
  id              String   @id @default(cuid())
  marketplaceItemId String
  item            MarketplaceItem @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        User     @relation("MarketplaceReviews", fields: [reviewerId], references: [id])
  
  rating          Int
  title           String
  content         String   @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([marketplaceItemId, reviewerId])
  @@index([marketplaceItemId, rating])
}

model MarketplaceItemRevision {
  id              String   @id @default(cuid())
  marketplaceItemId String
  item            MarketplaceItem @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)
  
  version         String
  metadata        Json
  changeNotes     String   @db.Text
  
  createdAt       DateTime @default(now())
}

model ImportedItem {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceItemId String?
  sourceItem     MarketplaceItem? @relation(fields: [marketplaceItemId], references: [id], onDelete: SetNull)
  
  itemType            ItemType
  itemName            String
  itemVersion         String
  
  importedFrameworkId String?
  sourceMetadata      Json?
  customizations      Json?
  
  importedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@unique([organizationId, marketplaceItemId])
  @@index([organizationId, importedAt])
}
