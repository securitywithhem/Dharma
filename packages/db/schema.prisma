generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model Plan {
  id             String  @id @default(cuid())
  name           String  @unique // "free", "pro", "enterprise"
  displayName    String // "Free", "Pro", "Enterprise"
  /// Razorpay Plan ID (plan_…). A Razorpay Plan is its own object with its own
  /// amount and currency, created in the Razorpay dashboard or API. Null for
  /// the free tier, and a plan with no ID here is correctly not sellable.
  razorpayPlanId String? // null for free tier

  price         Float          @default(0) // monthly price, in `currency`
  /// ISO-4217 code for `price`. The Razorpay Plan object holds the
  /// authoritative amount, and Razorpay India sells in INR. Rendering every
  /// plan with a hardcoded "$" would misstate the price to a paying customer.
  currency      String         @default("INR")
  limits        Json // { users: 5, frameworks: 3, storageMb: 100 }
  features      Json? // { apiAccess: false, sso: false, ...}
  isPublic      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  organizations Organization[]

  @@index([name])
}

model Organization {
  id              String               @id @default(cuid())
  name            String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  users           User[]
  frameworks      Framework[]
  evidences       Evidence[]
  policies        Policy[]
  auditLogs       AuditLog[]
  auditorKeys     AuditorAccess[]
  invites         OrganizationInvite[]
  chainAnchors    ChainAnchor[]
  connectors      Connector[]
  webhooks        Webhook[]
  auditExports    AuditExport[]
  importedItems   ImportedItem[]
  penTests        PenTest[]
  vulnerabilities Vulnerability[]
  assets          Asset[]
  verifiedAssets  VerifiedAsset[]
  controlMappings ControlMapping[]
  readinessScores ReadinessScore[]
  recommendations Recommendation[]

  // Phase 7 Part 1 — AI Advisor data layer
  aiAdvisorSessions      AIAdvisorSession[]
  organizationEmbeddings OrganizationEmbedding[]
  ingestedDocuments      IngestedDocument[]
  orgGraphNodes          OrgGraphNode[]
  orgGraphEdges          OrgGraphEdge[]

  // Phase 7 Part 2 — AI Advisor chat usage / token-cost tracking
  aiUsageLogs AIUsageLog[]

  // Phase 2 Feature 1: per-org AI provider config
  // mode: 'local-ollama' | 'local-small' | 'remote-opt-in'
  // stored as encrypted JSON blob
  aiProvider Json?

  // Billing and Subscription (Phase 3)
  planId             String?
  plan               Plan?               @relation(fields: [planId], references: [id])
  subscriptionStatus SubscriptionStatus? @default(ACTIVE)
  subscriptionEndsAt DateTime?

  // Razorpay is the sole payment provider. There is deliberately no
  // `paymentProvider` discriminator column: with one provider it would be the
  // same value on every paid row and null on every free one, which
  // `razorpaySubscriptionId IS NOT NULL` already tells us.
  razorpayCustomerId     String? @unique
  razorpaySubscriptionId String? @unique

  /// The subscription being REPLACED during a payment-method update.
  ///
  /// Razorpay binds the payment mandate to the subscription, so there is no
  /// "update card" call — changing the method means authorising a new
  /// subscription and cancelling the old one. That old ID is recorded here,
  /// server-side, rather than passed back by the browser: a client-supplied
  /// cancellation target is a subscription ID an attacker gets to choose.
  /// Cleared once the replacement is confirmed and the old one cancelled.
  /// Not @unique — it transiently holds the same value as the column above.
  razorpayPreviousSubscriptionId String?

  /// Indian GST identification number, collected for invoicing. Optional and
  /// currently display/record-only — Dharma does not yet issue GST-compliant
  /// invoices itself (Razorpay handles GST on its own fees). Stored now so
  /// that capability does not need a migration later. See claude/.
  gstin String?

  // Dunning — set on the FIRST failed charge and cleared on any successful
  // payment. The grace period is measured from this timestamp, not from the
  // most recent failure: Razorpay retries a failed charge several times, and
  // restarting the clock on each retry would make the grace period unbounded.
  // Null means "not delinquent".
  dunningStartedAt DateTime?

  // 64-bit unique lock ID for safe pg_advisory_xact_lock calls
  lockKeyId BigInt @unique @default(autoincrement())

  // Phase 8 Part 1 — Enterprise SSO / SCIM / RBAC
  settings    OrganizationSettings?
  customRoles CustomRole[]

  // Phase 8 Part 3 — MSSP grouping (BackendSchema.md inline comment)
  groupId String?
  group   OrganizationGroup? @relation("GroupOrgs", fields: [groupId], references: [id])

  // Phase 9 Part 1 — Endpoint agent (EDR-lite)
  endpoints      Endpoint[]
  endpointChecks EndpointCheck[]

  // Phase 9 Part 2 — Advanced reporting
  reports         Report[]
  reportSchedules ReportSchedule[]

  // Phase 9 Part 3 — Regulatory monitoring + public API
  regulatoryAlerts RegulatoryAlert[]
  apiKeys          ApiKey[]

  @@index([createdAt])
}

// Phase 3b — payment-provider webhook idempotency ledger.
//
// Providers guarantee at-least-once delivery and WILL redeliver events (retries
// after a timeout, or a manual resend from the dashboard). Without this table
// a redelivered subscription event would re-run the plan write and emit a
// second AuditEvent, corrupting the audit trail this product sells.
//
// A table rather than a Redis TTL key: the audit trail is the thing being
// protected, so the dedupe record must be as durable as the rows it guards —
// a Redis eviction or restart would silently reopen the double-write window.
// Rows are pruned by the billing-reconciliation worker, not kept forever.
model ProcessedWebhookEvent {
  id String @id @default(cuid())

  /// Razorpay's `x-razorpay-event-id`, or — when that header is absent — a
  /// SHA-256 of the signed body synthesised by the receiver. Unique on its own:
  /// with a single provider there is no second namespace to collide with, so
  /// the composite (provider, eventId) key this replaced bought nothing.
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  image              String?
  emailVerified      DateTime?
  role               Role                @default(VIEWER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts           Account[]
  sessions           Session[]
  auditLogs          AuditLog[]
  marketplaceItems   MarketplaceItem[]   @relation("MarketplaceItemAuthor")
  marketplaceReviews MarketplaceReview[] @relation("MarketplaceReviews")
  penTestsRequested  PenTest[]

  // WAVE 0.1 — scan-target ownership verification. Two relations because the
  // admin who requests a challenge and the one who confirms it need not be the
  // same person, and the audit trail must distinguish them.
  verifiedAssetsRequested VerifiedAsset[] @relation("VerifiedAssetRequester")
  verifiedAssetsVerified  VerifiedAsset[] @relation("VerifiedAssetVerifier")

  // Phase 7 Part 1 — AI Advisor data layer
  aiAdvisorSessions AIAdvisorSession[]
  ingestedDocuments IngestedDocument[] @relation("IngestedDocumentUploader")

  // Phase 8 Part 1 — Enterprise SSO / SCIM / RBAC.
  // customRoleId is nullable: when null, permission checks fall back to the
  // legacy `role` enum mapping (zero-downtime migration path).
  customRoleId   String?
  customRole     CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  // SCIM provisioning: the IdP's externalId, unique per org (not globally —
  // two different orgs' IdPs may reuse the same externalId value).
  scimExternalId String?
  // SCIM soft-delete: deactivated users keep their rows (audit integrity)
  // but can no longer sign in.
  isActive       Boolean     @default(true)

  // WAVE 5.2 — operator of THIS Dharma deployment, not an admin of any tenant.
  //
  // Deliberately a separate flag rather than a `Role` value, because `role` is
  // scoped to the user's own organization: marketplace.approveItem previously
  // gated on `role === "ADMIN"`, which meant ANY customer's org admin could
  // approve any other tenant's submission into the shared catalogue. Tenant
  // role and platform authority are different questions and must not share a
  // field.
  //
  // Not following the MsspGrant pattern (see 04_TECHNICAL/Authorization.md)
  // even though that is this schema's other cross-org mechanism: a grant is
  // the right shape when one *tenant* is given scoped, revocable, time-boxed
  // read access to named other tenants. Platform administration is not
  // tenant-to-tenant and has no scope list — it is a property of whoever runs
  // the deployment.
  //
  // There is deliberately NO API that sets this. It is granted out of band
  // (SQL/console by the deployment operator), so it cannot be escalated
  // through the application at all, and every grant leaves a trail outside a
  // surface an attacker who reached the app could reach.
  isPlatformAdmin Boolean @default(false)

  @@unique([organizationId, scimExternalId])
  @@index([organizationId])
  @@index([email])
  @@index([customRoleId])
  // No index on isPlatformAdmin: the only access path is findUnique by id
  // (sessionIdentity.ts reads the flag off the already-fetched row), so an
  // index would be write cost for no read benefit.
}

enum Role {
  ADMIN
  COMPLIANCE_MANAGER
  VIEWER
  PUBLISHER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Framework {
  id                  String       @id @default(cuid())
  name                String
  version             String       @default("1.0")
  description         String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controls            Control[]
  marketplaceSourceId String?
  importedItemId      String?

  // ----- Phase 6 Part 3: Readiness Scoring -----
  readinessScores ReadinessScore[]
  recommendations Recommendation[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Control {
  id               String            @id @default(cuid())
  frameworkId      String
  framework        Framework         @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  domain           String
  title            String
  description      String            @db.Text
  guidance         String?           @db.Text
  status           ControlStatus     @default(NOT_STARTED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  evidence         Evidence[]
  evidenceMappings EvidenceMapping[]
  vulnerabilities  Vulnerability[]
  endpointChecks   EndpointCheck[] // Phase 9 Part 1 — agent posture-check results mapped to this control

  // ----- Phase 6 Part 2: Cross-Walking -----
  sourceMappings ControlMapping[] @relation("SourceMappings")
  targetMappings ControlMapping[] @relation("TargetMappings")

  // ----- Phase 6 Part 3: Readiness Scoring -----
  recommendations Recommendation[]

  // ----- Phase 6: Advanced Frameworks — arbitrary-depth control hierarchy -----
  // Optional external identifier, e.g. NIST 800-53 "AC-2(1)". Distinct from `title`.
  code      String?
  // Self-referential hierarchy: family → control → sub-control → enhancement, unlimited depth.
  parentId  String?
  parent    Control?  @relation("ControlHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Control[] @relation("ControlHierarchy")
  // Materialized path: JSON array of ancestor control IDs, root-first, INCLUDING self.
  // Denormalized cache for O(1) ancestor lookups & Phase 6 cross-walk FK resolution.
  // Source of truth for structure is `parentId`; `path` is maintained by mutations/backfill.
  path      Json?
  depth     Int       @default(0)
  // Ordering among siblings sharing the same parentId (or the same frameworkId root set).
  sortOrder Int       @default(0)

  // pgvector embedding for semantic similarity search against Evidence embeddings.
  // Phase 6 Part 2 reuses this same column (title+description text, 384-dim
  // Ollama nomic-embed-text) to drive AI-suggested cross-walk mappings — see
  // src/server/services/controlEmbeddings.ts. No separate embedding table:
  // one embedding per control, consistent with the existing convention shared
  // by Evidence.embedding and Vulnerability.embedding.
  embedding            Unsupported("vector(384)")?
  embeddingStatus      EmbeddingStatus             @default(PENDING)
  embeddingError       String?                     @db.Text
  embeddingAttempts    Int                         @default(0)
  lastEmbeddingAttempt DateTime?

  @@index([frameworkId])
  @@index([domain])
  @@index([status])
  @@index([parentId])
  @@index([frameworkId, parentId, sortOrder])
  @@index([embeddingStatus])
}

model ControlMapping {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceControlId String
  sourceControl   Control         @relation("SourceMappings", fields: [sourceControlId], references: [id], onDelete: Cascade)
  targetControlId String
  targetControl   Control         @relation("TargetMappings", fields: [targetControlId], references: [id], onDelete: Cascade)
  mappingStrength MappingStrength
  rationale       String?         @db.Text
  suggestedByAI   Boolean         @default(false)
  confidenceScore Float?

  /// Review state. Defaults to ACCEPTED so every pre-existing row — all of
  /// which were created by a human through the picker — keeps its current
  /// behaviour with no backfill.
  ///
  /// This exists because mappings MOVE THE COMPLIANCE SCORE:
  /// readinessScoring's mappingBonus grants an unevidenced control up to full
  /// credit when it maps to an evidenced one (EQUIVALENT 1.0, PARTIAL 0.5),
  /// worth up to 15 points. Bulk machine-proposed mappings must therefore be
  /// invisible to scoring until a human accepts them — see the
  /// `status = 'ACCEPTED'` filter in readinessScoring.ts's mapping_agg CTE.
  ///
  /// REJECTED is a TOMBSTONE, not a delete: keeping the row is what stops a
  /// re-run of proposeForFrameworkPair from resurrecting a pair a human has
  /// already turned down.
  status       MappingStatus @default(ACCEPTED)
  reviewedById String?
  reviewedAt   DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// NOTE: this constraint is DIRECTIONAL — it does not prevent the reverse
  /// (target, source) pair. That predates the status column; the router
  /// compensates by checking both directions in application code. A proper
  /// expression index on (orgId, LEAST(src,tgt), GREATEST(src,tgt)) belongs in
  /// its own migration, behind a pre-check for orgs that already hold both
  /// directions, so a data problem cannot block this column.
  ///
  /// Status is a property of the PAIR, not a separate row: accepting is an
  /// in-place UPDATE, never an insert, so PROPOSED and ACCEPTED rows for the
  /// same directional pair cannot coexist.
  @@unique([organizationId, sourceControlId, targetControlId])
  @@index([organizationId, sourceControlId])
  @@index([organizationId, targetControlId])
  @@index([organizationId, status])
}

enum MappingStrength {
  EQUIVALENT
  PARTIAL
  RELATED
}

enum MappingStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

// ----- Phase 6 Part 3: Readiness Scoring & Recommendations -----

model ReadinessScore {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  frameworkId    String
  framework      Framework    @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  overallScore   Float
  evidenceScore  Float
  mappingBonus   Float
  // Per-family { familyId, familyName, totalLeaves, evidencedLeaves, mappingCreditSum, familyScore }[]
  // plus the leaf/evidence totals the score was computed from — see
  // src/server/services/readinessScoring.ts's ScoreBreakdown type.
  breakdown      Json
  computedAt     DateTime     @default(now())

  @@unique([organizationId, frameworkId])
  @@index([organizationId, frameworkId, computedAt])
}

model Recommendation {
  id                 String               @id @default(cuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  frameworkId        String
  framework          Framework            @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  controlId          String?
  control            Control?             @relation(fields: [controlId], references: [id], onDelete: Cascade)
  type               RecommendationType
  title              String
  description        String               @db.Text
  potentialScoreGain Float?
  status             RecommendationStatus @default(OPEN)
  createdAt          DateTime             @default(now())
  dismissedAt        DateTime?

  @@index([organizationId, frameworkId, status])
  @@index([organizationId, frameworkId, potentialScoreGain])
}

enum RecommendationType {
  MISSING_EVIDENCE
  STALE_EVIDENCE
  UNMAPPED_HIGH_VALUE_CONTROL
  FAMILY_LOW_COVERAGE
}

enum RecommendationStatus {
  OPEN
  IN_PROGRESS
  DISMISSED
  RESOLVED
}

enum ControlStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  NOT_APPLICABLE
}

model Evidence {
  id                   String                      @id @default(cuid())
  controlId            String
  control              Control                     @relation(fields: [controlId], references: [id], onDelete: Cascade)
  organizationId       String
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Phase 2 Feature 2: link back to the connector that auto-created this row
  connectorId          String?
  connector            Connector?                  @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  // Phase 4 Part 2: link back to the EvidenceMapping rule that auto-collected this row.
  // Not present in the original Part 1 schema — added here per the Implementation
  // Plan's fallback instruction, since no BackendSchema.md exists in the repo to
  // confirm it was already covered.
  evidenceMappingId    String?
  evidenceMapping      EvidenceMapping?            @relation(fields: [evidenceMappingId], references: [id], onDelete: SetNull)
  fileName             String
  filePath             String
  fileSizeBytes        Int                         @default(0)
  type                 EvidenceType
  summary              String?                     @db.Text
  collectedAt          DateTime                    @default(now())
  expiresAt            DateTime?
  embedding            Unsupported("vector(384)")?
  embeddingStatus      EmbeddingStatus             @default(PENDING)
  embeddingError       String?                     @db.Text
  embeddingAttempts    Int                         @default(0)
  lastEmbeddingAttempt DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  source               String                      @default("manual")

  // Phase 7 Part 3: NLP evidence auto-tagging (PRD Phase 7).
  // AI-SUGGESTED cross-control associations, computed async after upload by the
  // evidenceAutoTag worker. These are SUGGESTIONS ONLY — never auto-applied.
  // The user accepts (which creates a real ControlMapping / re-assigns) or
  // rejects them in the UI, preserving audit integrity. Shape of
  // suggestedControlIds: [{ controlId, code, title, confidence }].
  suggestedControlIds Json?
  autoTagConfidence   Float?
  autoTagStatus       AutoTagStatus @default(NONE)

  @@index([controlId])
  @@index([organizationId])
  @@index([type])
  @@index([connectorId])
  @@index([evidenceMappingId])
  @@index([embeddingStatus])
}

enum EvidenceType {
  SCREENSHOT
  POLICY_DOC
  API_RESPONSE
  LOG_EXCERPT
  CERTIFICATE
  OTHER
}

enum EmbeddingStatus {
  PENDING
  SUCCESS
  FAILED
}

model Policy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  content        String       @db.Text
  version        Int          @default(1)
  isPublished    Boolean      @default(false)
  policyType     PolicyType
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([policyType])
}

enum PolicyType {
  PRIVACY_POLICY
  DATA_RETENTION
  ACCESS_CONTROL
  INCIDENT_RESPONSE
  OTHER
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String
  changes        Json?
  timestamp      DateTime     @default(now())
  previousHash   String?
  currentHash    String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([timestamp])
  @@index([userId])
}

model RegulationSnippet {
  id            String                      @id @default(cuid())
  frameworkName String
  sectionNumber String
  content       String                      @db.Text
  embedding     Unsupported("vector(384)")?
  createdAt     DateTime                    @default(now())

  @@index([frameworkName])
}

model AuditorAccess {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash        String?      @unique
  sessionTokenHash String?      @unique
  expiresAt        DateTime
  isActive         Boolean      @default(true)
  exchangedAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([organizationId])
  @@index([expiresAt])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(VIEWER)
  token          String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
  @@index([expiresAt])
}

// ============================================================
// Phase 2 Feature 3: External Audit Chain Anchors
// ============================================================

model ChainAnchor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rootHash       String
  recordCount    Int
  fromLogId      String
  toLogId        String
  anchoredAt     DateTime     @default(now())
  storageKey     String // path in ANCHOR_STORAGE_BUCKET
  publicProof    String? // OpenTimestamps .ots receipt path, or null

  @@index([organizationId])
  @@index([anchoredAt])
}

// ============================================================
// Phase 2 Feature 2: Automated Evidence Connectors
// ============================================================

model Connector {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type             ConnectorType
  name             String
  // Legacy secret storage (Phase 2 GitHub/Vercel/AWS-key connectors), encrypted via
  // src/lib/crypto/credentials.ts. New (Phase 4 Part 1) connectors store everything,
  // including secrets, in `config` via src/server/lib/crypto/connectorVault.ts instead.
  credentials      String?
  config           Json // AES-256 encrypted JSON blob
  status           ConnectorStatus   @default(DISCONNECTED)
  lastSyncAt       DateTime?
  lastError        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  evidenceMappings EvidenceMapping[]
  evidence         Evidence[]

  @@index([organizationId])
}

enum ConnectorType {
  AWS
  AZURE
  GCP
  GITHUB
  OKTA
  JIRA
  VERCEL
}

enum ConnectorStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  TESTING
}

model EvidenceMapping {
  id              String     @id @default(cuid())
  connectorId     String
  connector       Connector  @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  controlId       String
  control         Control    @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evidenceType    String
  schedule        String?
  lastCollectedAt DateTime?
  createdAt       DateTime   @default(now())
  evidence        Evidence[]

  @@index([connectorId])
  @@index([controlId])
}

// ============================================================
// Phase 4 Part 3: Outgoing Webhook Dispatcher
// ============================================================

model Webhook {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  // AES-256-GCM encrypted via src/server/lib/crypto/secretVault.ts — same
  // envelope format as connectorVault's config blob. Never returned to the
  // client after creation; webhook.list only exposes a redacted preview.
  secret         String
  events         String[]
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deliveries     WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  responseCode Int?
  success      Boolean  @default(false)
  attempt      Int      @default(1)
  createdAt    DateTime @default(now())

  @@index([webhookId])
  @@index([createdAt])
}

// ============================================================
// Phase 2 Feature 4: Policy Templates
// ============================================================

model PolicyTemplate {
  id           String     @id @default(cuid())
  policyType   PolicyType
  name         String
  version      String
  bodyTemplate String     @db.Text // Handlebars source with {{placeholders}}
  variables    Json // [{ key, label, type, required, defaultValue? }]
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([policyType, name, version])
  @@index([policyType])
}

// ============================================================
// Phase 2 Feature 5: Auditor Export Packages
// ============================================================

model AuditExport {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy     String // userId who triggered export
  frameworkIds    Json // string[]
  filePath        String // MinIO object key
  includeRawFiles Boolean      @default(false)
  createdAt       DateTime     @default(now())
  expiresAt       DateTime // presigned URL expiry (24h after creation)

  @@index([organizationId])
  @@index([expiresAt])
}

// ============================================================
// Phase 3c: Marketplace
// ============================================================

enum ItemType {
  FRAMEWORK
  TEMPLATE
  CONNECTOR
}

model MarketplaceItem {
  id               String   @id @default(cuid())
  type             ItemType
  name             String
  slug             String   @unique
  description      String   @db.Text
  shortDescription String?
  /// Nullable so deleting an organization does not fail.
  ///
  /// MarketplaceItem and MarketplaceReview are the only two models that
  /// reference User WITHOUT being tenant-scoped themselves. Every other User
  /// reference (PenTest.requestedBy, VerifiedAsset.requestedBy, …) sits on a
  /// model that cascades from Organization, so the cascade clears those rows
  /// before the User delete is attempted. These two are global, published
  /// artifacts — nothing cascades them — so a Restrict FK here blocked
  /// offboarding any tenant whose members had ever published or reviewed.
  ///
  /// SetNull rather than Cascade, deliberately: other organizations import
  /// these items, and ImportedItem.sourceItem is already SetNull, so the
  /// schema already treats a published item as outliving its origin. Deleting
  /// it would destroy another tenant's content and provenance to complete an
  /// unrelated tenant's offboarding.
  ///
  /// Note this ANONYMIZES rather than erases. If a DPDP/GDPR erasure request
  /// requires the item's content to go, that is a separate, deliberate flow —
  /// it should not be a silent side effect of offboarding.
  authorId         String?
  author           User?    @relation("MarketplaceItemAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  price    Float  @default(0)
  currency String @default("USD")

  metadata   Json
  category   String
  tags       String[]
  logo       String?
  coverImage String?

  version     String  @default("1.0.0")
  isPublic    Boolean @default(false)
  isOfficial  Boolean @default(false)
  ratings     Float   @default(0)
  reviewCount Int     @default(0)
  downloads   Int     @default(0)

  reviews       MarketplaceReview[]
  importedItems ImportedItem[]
  revisions     MarketplaceItemRevision[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Phase 9 Part 3 — regulatory version history
  frameworkVersions FrameworkVersion[]

  @@index([authorId, isPublic, createdAt])
  @@index([category, isPublic])
}

model MarketplaceReview {
  id                String          @id @default(cuid())
  marketplaceItemId String
  item              MarketplaceItem @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)
  /// Nullable for the same reason as MarketplaceItem.authorId above — and this
  /// one blocked more than publishing: an organization that had only ever
  /// REVIEWED someone else's item could not be deleted.
  ///
  /// SetNull rather than Cascade because `ratings` and `reviewCount` on
  /// MarketplaceItem are denormalized. Deleting review rows out from under
  /// them would silently overstate an item's rating with no trigger or
  /// application hook to recompute; anonymizing keeps the aggregates true.
  ///
  /// The @@unique below still enforces one review per user per item: Postgres
  /// treats NULLs as distinct, so anonymized rows accumulate freely.
  reviewerId        String?
  reviewer          User?           @relation("MarketplaceReviews", fields: [reviewerId], references: [id], onDelete: SetNull)

  rating  Int
  title   String
  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([marketplaceItemId, reviewerId])
  @@index([marketplaceItemId, rating])
}

model MarketplaceItemRevision {
  id                String          @id @default(cuid())
  marketplaceItemId String
  item              MarketplaceItem @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)

  version     String
  metadata    Json
  changeNotes String @db.Text

  createdAt DateTime @default(now())
}

model ImportedItem {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceItemId String?
  sourceItem        MarketplaceItem? @relation(fields: [marketplaceItemId], references: [id], onDelete: SetNull)

  itemType    ItemType
  itemName    String
  itemVersion String

  importedFrameworkId String?
  sourceMetadata      Json?
  customizations      Json?

  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([organizationId, marketplaceItemId])
  @@index([organizationId, importedAt])
}

// ============================================================
// Phase 5 Part 1: Penetration Testing & Vulnerability Scanning
// (obsidian-vaults/Dharma-Project/{PRD,TRD,BackendSchema}.md)
// ============================================================

model PenTest {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  target         String // domain or IP, org-admin-confirmed as owned
  type           PenTestType
  status         PenTestStatus @default(QUEUED)
  result         Json? // raw scan output / error detail

  // MinIO object path for the raw scanner stdout (pentest-logs/{orgId}/{id}.jsonl),
  // kept separate from `result` for audit/debug access to the untruncated log.
  containerLogUrl String?

  // Cron expression for recurring scans (PRD "scheduled cadence" requirement).
  // When set, a BullMQ repeatable job re-creates a fresh PenTest row on each fire
  // rather than re-running this row, so history of each run is preserved.
  scheduleCron String?

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id])

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  vulnerabilities Vulnerability[]

  @@index([organizationId, createdAt])
}

enum PenTestType {
  EXTERNAL_NETWORK
  WEB_APP
}

enum PenTestStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Vulnerability {
  id             String       @id @default(cuid())
  penTestId      String?
  penTest        PenTest?     @relation(fields: [penTestId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controlId      String?
  control        Control?     @relation(fields: [controlId], references: [id], onDelete: SetNull)
  assetId        String?
  asset          Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  title          String
  description    String       @db.Text
  severity       Severity
  cvssScore      Float?
  // Full CVSS v3.1 vector string (e.g. "CVSS:3.1/AV:N/AC:L/..."), kept
  // alongside the derived cvssScore so the score can be redisplayed or
  // recalculated without re-deriving it from raw scan output.
  cvssVector     String?
  remediation    String?      @db.Text
  status         VulnStatus   @default(OPEN)
  createdAt      DateTime     @default(now())

  // pgvector embedding of title+description+remediation, for future
  // semantic search / AI advisor retrieval (Phase 7). Same vector(384)
  // convention as Control.embedding and Evidence.embedding — populated
  // best-effort via Ollama, written with raw SQL (see src/workers/
  // classification.ts's identical pattern; Prisma has no native vector type).
  embedding Unsupported("vector(384)")?

  @@index([organizationId, createdAt])
}

// Phase 5 Part 2 — lightweight target registry so a Vulnerability can
// optionally reference a specific scanned asset (domain/IP/hostname)
// rather than only a Control. PRD mentions "assets" but the Part 1 schema
// only had controlId — this fills that gap.
model Asset {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  identifier      String // domain, IP, or hostname
  createdAt       DateTime        @default(now())
  vulnerabilities Vulnerability[]

  @@index([organizationId, createdAt])
}

// -----------------------------------------------------------------------------
// Scan-target ownership verification (WAVE 0.1)
//
// DEVIATION (deliberate, flagged per Coding_Standards.md): this does NOT extend
// the `Asset` model above, even though the brief asks to "extend rather than
// duplicate". `Asset` is an *inventory* record — rows are created implicitly
// from scan findings (see autoMapVulnerabilities.ts) and carry no ownership
// semantics or uniqueness constraint. If authorization to scan were read off
// `Asset`, a scan finding could mint the very row that authorizes scanning it,
// which is a self-granting privilege escalation. `VerifiedAsset` is therefore a
// separate, append-mostly authorization record: nothing but an explicit,
// server-checked DNS/HTTP challenge can create a verified row.
// -----------------------------------------------------------------------------

enum VerifiedAssetKind {
  DOMAIN
  CIDR
}

enum AssetVerificationMethod {
  DNS_TXT
  HTTP_FILE
}

model VerifiedAsset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Normalized claim: a lowercased hostname (DOMAIN) or a CIDR block (CIDR).
  /// Normalization happens in assetVerification.ts so the unique constraint
  /// below cannot be sidestepped by casing or a trailing dot.
  value String
  kind  VerifiedAssetKind @default(DOMAIN)

  method AssetVerificationMethod @default(DNS_TXT)

  /// The challenge nonce, published by the claimant as `dharma-verify=<token>`.
  ///
  /// DEVIATION (deliberate): stored in PLAINTEXT, against the repo's hash-only
  /// convention for tokens (OrganizationSettings.scimTokenHash,
  /// Endpoint.enrollmentTokenHash). Those are bearer credentials — this is not.
  /// It is a public proof-of-control nonce that the claimant publishes to the
  /// world in DNS, and the server must re-read the exact string out of the TXT
  /// record to compare it. A hash cannot be compared against a DNS answer.
  /// Knowing the token grants nothing: using it requires controlling the zone.
  verificationToken String

  /// Null until the challenge is confirmed server-side. Only a non-null
  /// verifiedAt (with a null revokedAt) authorizes a scan.
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("VerifiedAssetVerifier", fields: [verifiedById], references: [id])

  requestedById String
  requestedBy   User   @relation("VerifiedAssetRequester", fields: [requestedById], references: [id])

  /// Set when an admin withdraws the claim. Revocation is a tombstone rather
  /// than a delete so the authorization trail survives — this row is the record
  /// that protects the operator if a scanned party ever disputes a scan.
  revokedAt DateTime?

  /// Number of failed confirmation attempts, to bound challenge grinding.
  failedAttempts Int       @default(0)
  lastAttemptAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, value])
  @@index([organizationId, verifiedAt])
}

enum Severity {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VulnStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

// =============================================================================
// Phase 7 Part 1 — AI Advisor data layer
//
// Document ingestion → chunk → embed → tenant-scoped knowledge graph.
// This part builds ONLY the data layer; the RAG retrieval layer (Part 2) and
// chat endpoint/UI (Part 2/3) are out of scope here.
//
// Embedding dimension is 384 to match the existing Dharma pgvector columns
// (Control/Evidence/Vulnerability) and the Ollama `nomic-embed-text` default —
// see 2_TRD.md §3 "yielding 384-dimension vectors". The OpenAI provider path
// (text-embedding-3-small, 1536-dim) would require a separate column/migration
// and is intentionally not enabled here.
// =============================================================================

/// A persisted AI Advisor chat session. Populated in Part 2/3; the model is
/// added now so the data layer's relations are complete.
model AIAdvisorSession {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Json // array of { role, content, citations? }
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId])
}

/// One embedded chunk of an org document. Per-org, never shared across tenants
/// (2_TRD.md: local-first, no training on customer data; embeddings per org).
/// `embedding` is written via raw SQL ($1::vector) since Prisma has no native
/// vector type — same pattern as Control/Evidence embeddings.
model OrganizationEmbedding {
  id               String                      @id @default(cuid())
  organizationId   String
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType     String // "control" | "evidence" | "policy_doc" | "incident_report"
  documentId       String
  sourceDocumentId String? // FK to IngestedDocument when applicable
  sourceDocument   IngestedDocument?           @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  embedding        Unsupported("vector(384)")?
  chunkIndex       Int
  content          String                      @db.Text
  metadata         Json? // { pageNumber, section, graphNodeId }
  createdAt        DateTime                    @default(now())

  @@index([organizationId, documentType])
  @@index([sourceDocumentId])
}

/// A raw document uploaded for ingestion (policy, incident report, etc.). The
/// file itself lives in MinIO under `s3Key`; this row tracks pipeline state.
model IngestedDocument {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById   String
  uploadedBy     User            @relation("IngestedDocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  filename       String
  mimeType       String
  s3Key          String // MinIO object key
  status         IngestionStatus @default(PENDING)
  chunkCount     Int             @default(0)
  graphNodeCount Int             @default(0)
  error          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  embeddings OrganizationEmbedding[]
  graphNodes OrgGraphNode[]
  graphEdges OrgGraphEdge[]

  @@index([organizationId, status])
}

/// A node in the per-org knowledge graph extracted from ingested documents.
/// Graphify (the CLI/skill) is not an in-process runtime SDK, so extraction is
/// persisted here in Postgres and hard-scoped by `organizationId` — this is the
/// tenant-isolation boundary and the pluggable seam a graph DB could replace.
model OrgGraphNode {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceDocumentId String?
  sourceDocument   IngestedDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  nodeType         String // "control" | "policy" | "requirement" | "system" | "entity"
  label            String
  metadata         Json?
  createdAt        DateTime          @default(now())

  outgoingEdges OrgGraphEdge[] @relation("OrgGraphEdgeFrom")
  incomingEdges OrgGraphEdge[] @relation("OrgGraphEdgeTo")

  @@index([organizationId, nodeType])
  @@index([sourceDocumentId])
}

/// A directed relationship between two OrgGraphNodes, e.g.
/// "Policy X" —[implements]→ "Control CC6.1". Also org-scoped.
model OrgGraphEdge {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceDocumentId String?
  sourceDocument   IngestedDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  fromNodeId       String
  fromNode         OrgGraphNode      @relation("OrgGraphEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId         String
  toNode           OrgGraphNode      @relation("OrgGraphEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  relation         String // e.g. "implements", "requires", "mitigates"
  createdAt        DateTime          @default(now())

  @@index([organizationId])
  @@index([sourceDocumentId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

enum IngestionStatus {
  PENDING
  CHUNKING
  EMBEDDING
  GRAPH_EXTRACTING
  COMPLETED
  FAILED
}

/// Phase 7 Part 3 — lifecycle of an Evidence row's NLP auto-tag suggestions.
enum AutoTagStatus {
  NONE // not yet processed
  PROCESSING // worker running
  SUGGESTED // suggestions available, awaiting user accept/reject
  ACCEPTED // user accepted a suggestion
  REJECTED // user dismissed suggestions
  FAILED // auto-tag job failed (non-fatal to the evidence itself)
}

/// Phase 7 Part 2 — per-request AI token usage, for per-org rate/budget
/// enforcement and cost reporting. One row per completed chat turn. The
/// monthly budget check sums promptTokens+completionTokens for the org over
/// the current calendar month against Plan.limits.aiTokensPerMonth.
model AIUsageLog {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  sessionId        String?
  promptTokens     Int
  completionTokens Int
  createdAt        DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// ----- Phase 8 Part 1: Enterprise SSO / SCIM / RBAC -----

/// Per-org enterprise settings (BackendSchema.md "Phase 8" block).
/// Deviations from the doc, flagged in the Phase 8 summary:
/// - `ssoEnforced` column (App Flow journey 6 step 4 needs a queryable flag
///   at login time; the doc only sketched ssoConfig Json).
/// - `scimTokenHash`: the SCIM bearer token is stored as a SHA-256 hash
///   (validate-only, shown once at creation) instead of the reversible
///   AES encryption the task brief suggested — same pattern as
///   AuditorAccess.sessionTokenHash, and strictly safer at rest.
model OrganizationSettings {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // { type: "SAML"|"OIDC", ... } — secret members (OIDC clientSecret) are
  // stored as AES-256-GCM envelopes (secretVault), never plaintext.
  ssoConfig             Json?
  ssoEnforced           Boolean      @default(false)
  scimEnabled           Boolean      @default(false)
  scimTokenHash         String?
  whiteLabel            Json? // { logoUrl, primaryColor, customDomain, customDomainVerified, css } — Phase 8 Part 2
  auditLogRetentionDays Int          @default(365)
  // Phase 8 Part 2 — SIEM export target: { type: "splunk-hec", url, tokenEnc }
  // or { type: "syslog", host, port, protocol }. Secret members are
  // AES-256-GCM envelopes (siemVault), never plaintext.
  siemExportConfig      Json?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

/// Custom RBAC role (new model, not in BackendSchema.md — flagged as a
/// deviation; Implementationplan.md task 3 "extend MemberRole to permissions
/// JSON" is realized as this model plus User.customRoleId).
model CustomRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  // { "controls.read": true, "controls.write": false, ... } — keys validated
  // against PERMISSION_KEYS in src/server/services/rbac/permissions.ts
  permissions    Json
  // Seeded copies of the legacy Role enum defaults; protected from deletion.
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ----- Phase 8 Part 3: MSSP Operations -----

/// BackendSchema.md "MSSP support" block: a partner (MSSP) groups its client
/// organizations under its own parent org.
model OrganizationGroup {
  id            String         @id @default(cuid())
  name          String
  parentOrgId   String? // the MSSP's own org
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[] @relation("GroupOrgs")
  grants        MsspGrant[]

  @@index([parentOrgId])
}

/// New model, NOT in BackendSchema.md — flagged as a deviation in the Phase 8
/// report. Cross-tenant reads are gated on an explicit, time-boxable,
/// revocable grant with an org-id allow-list, rather than "role == MSSP admin
/// ⇒ bypass tenant isolation for everything": bounded blast radius and a
/// concrete revocation mechanism, which any security review would demand
/// before shipping cross-tenant access. The ONLY consumer is
/// src/server/services/mssp/aggregateQuery.service.ts.
model MsspGrant {
  id            String            @id @default(cuid())
  groupId       String
  group         OrganizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  grantedUserId String // the MSSP admin user
  // Explicit allow-list of client org IDs — never implicitly "all orgs in
  // the group", so adding an org to a group later never silently widens an
  // existing grant.
  scopeOrgIds   String[]
  expiresAt     DateTime? // optional time-boxed access
  revokedAt     DateTime? // set by mssp.revokeGrant — blocks further use immediately
  createdAt     DateTime          @default(now())

  @@index([grantedUserId])
  @@index([groupId])
}

// ----- Phase 9 Part 1: Endpoint Agent (EDR-lite) -----
// PRD Phase 9: "Agent installation on endpoints for continuous compliance
// monitoring (EDR-lite)." Follows the Phase 4 Connector model's tenant-scoping
// and index conventions (onDelete: Cascade on the org relation — repo-wide
// convention the task brief omitted).

model Endpoint {
  id                  String          @id @default(cuid())
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostname            String
  os                  String
  osVersion           String
  agentVersion        String
  // DEVIATION (flagged): the task brief names this `enrollmentToken` storing the
  // token itself. Per Step 2 ("hashed with SHA-256 before storage, never store
  // plaintext"), the column stores the SHA-256 HASH — same validate-only pattern
  // as OrganizationSettings.scimTokenHash (Phase 8). The plaintext is returned
  // to the caller exactly once at enrollment and never persisted.
  enrollmentTokenHash String          @unique
  status              EndpointStatus  @default(PENDING)
  lastHeartbeatAt     DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  checks              EndpointCheck[]

  @@index([organizationId, status])
}

enum EndpointStatus {
  PENDING // enrolled, no heartbeat yet
  ACTIVE // heartbeat received within the staleness window
  STALE // no heartbeat for > 48h (set by the stale-sweep worker)
  REVOKED // token revoked by an admin; heartbeats rejected
}

model EndpointCheck {
  id             String       @id @default(cuid())
  endpointId     String
  endpoint       Endpoint     @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkType      String // "disk_encryption" | "os_patch_level" | "screen_lock" | "firewall_status"
  result         Json // { pass: boolean, raw: {...} }
  // Nullable: a check whose type has no mapped control in this org's frameworks
  // is stored with controlId null and surfaced as an "unmapped check" in the UI.
  controlId      String?
  control        Control?     @relation(fields: [controlId], references: [id], onDelete: SetNull)
  collectedAt    DateTime     @default(now())

  @@index([organizationId, checkType, collectedAt])
  @@index([endpointId, collectedAt])
}

// ----- Phase 9 Part 2: Advanced Reporting -----
// PRD Phase 9: "Advanced reporting (custom PDF reports, board summaries)."
// PDF generation is async/queued (2_TRD.md long-running tasks), never in a
// request thread.

model Report {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ReportType
  title          String
  // Section selection, date range, framework filters (CUSTOM_PDF) — BOARD_SUMMARY
  // is auto-composed so config is minimal.
  config         Json
  status         ReportStatus @default(QUEUED)
  // MinIO object KEY (not a raw presigned URL — presigned URLs are minted
  // on-demand in report.get, per the brief's "presigned reference key" note).
  fileUrl        String?
  // Failure detail lives here for the UI; the raw stack trace goes only to the
  // AuditLog metadata, never surfaced to the client.
  errorMessage   String?
  // Plain actor id (no FK) — matches the brief and the repo's audit-actor style.
  generatedById  String
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  @@index([organizationId, type, createdAt])
  @@index([organizationId, status])
}

enum ReportType {
  CUSTOM_PDF
  BOARD_SUMMARY
}

enum ReportStatus {
  QUEUED
  GENERATING
  COMPLETED
  FAILED
}

model ReportSchedule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  // Same shape as Report.config plus a `type` discriminator.
  reportConfig   Json
  // Stored as a cron expression, but the UI only offers daily/weekly/monthly
  // presets that map to fixed crons (no raw cron input).
  cron           String
  recipients     Json // string[] of emails
  enabled        Boolean      @default(true)
  lastRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, enabled])
}

// ----- Phase 9 Part 3: Regulatory Change Monitoring + Public API -----
// PRD Phase 9: "Regulatory change monitoring – alerts when frameworks update"
// and "Full API for third-party integrations."

/// A published version of a framework (MarketplaceItem of type FRAMEWORK).
/// controlsSnapshot holds the full control tree at that version so the diff
/// engine can compute added/removed/modified controls between versions.
model FrameworkVersion {
  id                String            @id @default(cuid())
  marketplaceItemId String
  marketplaceItem   MarketplaceItem   @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)
  version           String
  changelog         String            @db.Text
  controlsSnapshot  Json
  publishedAt       DateTime          @default(now())
  alerts            RegulatoryAlert[]

  @@unique([marketplaceItemId, version])
  @@index([marketplaceItemId, publishedAt])
}

/// Per-org alert raised when a framework the org imported gets a new version.
model RegulatoryAlert {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  frameworkVersionId String
  frameworkVersion   FrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Cascade)
  diffSummary        Json // { added: [], removed: [], modified: [] }
  status             AlertStatus      @default(UNREAD)
  createdAt          DateTime         @default(now())

  // One alert per org per framework version — re-running fanout is idempotent.
  @@unique([organizationId, frameworkVersionId])
  @@index([organizationId, status])
}

enum AlertStatus {
  UNREAD
  ACKNOWLEDGED
  DISMISSED
}

/// Third-party API credential. Only the SHA-256 hash is stored (never the
/// plaintext), same rule as Phase 9 Part 1 endpoint enrollment tokens and the
/// Phase 8 SCIM token. keyPrefix is a non-secret identifier shown in the UI.
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String       @unique
  keyPrefix      String // e.g. "dhm_a1b2" — first chars, for identification only
  scopes         Json // ["controls:read","evidence:write",...]
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime     @default(now())

  @@index([organizationId, revokedAt])
}
