# ============================================================
# Dharma – Docker Compose Configuration Template
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.docker
# 2. Replace all "TODO_*" values with strong, unique secrets
# 3. DO NOT commit .env.docker to version control!
# ============================================================

NODE_ENV=production

# PostgreSQL
POSTGRES_DB=dharma_db
POSTGRES_USER=dharma
POSTGRES_PASSWORD=TODO_GENERATE_SECURE_POSTGRES_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dharma:TODO_GENERATE_SECURE_POSTGRES_PASSWORD@postgres:5432/dharma_db?schema=public

# Redis
REDIS_PASSWORD=TODO_GENERATE_SECURE_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_URL=redis://:TODO_GENERATE_SECURE_REDIS_PASSWORD@redis:6379

# MinIO
MINIO_ENDPOINT=minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=dharma_minio_admin
MINIO_SECRET_KEY=TODO_GENERATE_SECURE_MINIO_SECRET_KEY
MINIO_BUCKET=dharma-evidence
MINIO_REGION=us-east-1
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_PUBLIC_URL=http://localhost:9000

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_MODEL_LLM=llama3:8b
OLLAMA_MODEL_EMBEDDING=all-minilm
OLLAMA_WORKER_CONCURRENCY=3

# NextAuth.js
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=TODO_GENERATE_32_CHAR_RANDOM_SECRET

# Application
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXTJS_PORT=3000
LOG_LEVEL=info

# Caddy
CADDY_DOMAIN=your-domain.com

# Grafana / Prometheus
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=TODO_GENERATE_SECURE_GRAFANA_PASSWORD
GRAFANA_PORT=3001

# Backup
BACKUP_HOST_PATH=/tmp/dharma-backups
BACKUP_RETENTION_DAYS=7

# ── Razorpay (sole payment provider) ────────────────────────────────────
# Test Mode keys require no KYC (Dashboard → Settings → API Keys).
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
# A value you choose; must match the webhook secret in the Razorpay dashboard.
# If unset, every webhook is rejected 500 "not configured" and no plan applies.
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Where CRITICAL ops alerts are POSTed (Slack/Discord/ntfy incoming webhook).
# Unset = structured CRITICAL lines on stdout only.
OPS_ALERT_WEBHOOK_URL=
