# Testing Environment Variables
NODE_ENV=test
DATABASE_URL=postgresql://dharma:dharmapass@localhost:5432/dharma_db?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=test-secret-that-is-at-least-thirty-two-chars-long
# docker-compose's redis service has no host port mapping and only resolves
# "redis" inside the docker network — override with localhost + the same
# REDIS_PASSWORD from .env so tests running on the host can reach it too.
REDIS_URL=redis://:redispass@localhost:6379
