# ============================================================
# Kubernetes Secrets Template
# Usage: Replace values, then:
#   kubectl apply -f secrets.yaml
#
# ⚠️ WARNING: Store encrypted in sealed-secrets or Vault
# Never commit unencrypted secrets to git
# ============================================================

---
# PostgreSQL Credentials
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: dharma
type: Opaque
stringData:
  username: dharma
  password: GENERATE_STRONG_PASSWORD_HERE
  database: dharma_db
  connection-url: postgresql://dharma:GENERATE_STRONG_PASSWORD_HERE@postgres.dharma.svc.cluster.local:5432/dharma_db

---
# Redis Credentials
apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  namespace: dharma
type: Opaque
stringData:
  password: GENERATE_STRONG_PASSWORD_HERE
  connection-url: redis://:GENERATE_STRONG_PASSWORD_HERE@redis.dharma.svc.cluster.local:6379

---
# MinIO Credentials
apiVersion: v1
kind: Secret
metadata:
  name: minio-secret
  namespace: dharma
type: Opaque
stringData:
  root-user: minioadmin
  root-password: GENERATE_STRONG_PASSWORD_HERE
  access-key: GENERATE_ACCESS_KEY_HERE
  secret-key: GENERATE_SECRET_KEY_HERE

---
# Next.js Application Secrets
apiVersion: v1
kind: Secret
metadata:
  name: nextjs-secret
  namespace: dharma
type: Opaque
stringData:
  nextauth-secret: GENERATE_32_CHAR_RANDOM_STRING_HERE

---
# Docker Registry Credentials (if using private registry)
apiVersion: v1
kind: Secret
metadata:
  name: registry-credentials
  namespace: dharma
type: kubernetes.io/dockercfg
data:
  .dockercfg: BASE64_ENCODED_DOCKER_CONFIG_HERE

---
# TLS Certificate & Key (if not using cert-manager)
apiVersion: v1
kind: Secret
metadata:
  name: dharma-tls-secret
  namespace: dharma
type: kubernetes.io/tls
data:
  tls.crt: BASE64_ENCODED_CERTIFICATE_HERE
  tls.key: BASE64_ENCODED_PRIVATE_KEY_HERE

# ============================================================
# GENERATION COMMANDS
# ============================================================
# Generate strong password (32 chars):
#   openssl rand -base64 32
#
# Generate NEXTAUTH_SECRET:
#   openssl rand -base64 32
#
# Generate Docker config:
#   cat ~/.docker/config.json | base64 -w 0
#
# Generate TLS cert (self-signed):
#   openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#     -keyout tls.key -out tls.crt -subj "/CN=dharma.example.com"
#   cat tls.crt | base64 -w 0
#   cat tls.key | base64 -w 0
#
# To apply with Sealed Secrets:
#   kubectl create secret generic postgres-secret \
#     --from-literal=password=XXX -n dharma --dry-run=client -o yaml | \
#     kubeseal -f - > postgres-sealed.yaml
#   kubectl apply -f postgres-sealed.yaml
# ============================================================
