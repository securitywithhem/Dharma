{
  "name": "dharma",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted compliance management platform for Indian MSMEs.",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "dotenv -e envs/.env.development -- next dev",
    "build": "dotenv -e envs/.env.production -- prisma generate --schema packages/db/schema.prisma && dotenv -e envs/.env.production -- next build",
    "start": "dotenv -e envs/.env.production -- next start",
    "postinstall": "prisma generate --schema packages/db/schema.prisma && node scripts/fix-readdir-glob-exports.js",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "dotenv -e envs/.env.test -- jest --runInBand",
    "test:watch": "dotenv -e envs/.env.test -- jest --watch",
    "test:e2e": "dotenv -e envs/.env.test -- playwright test",
    "db:generate": "dotenv -e envs/.env.development -- prisma generate --schema packages/db/schema.prisma",
    "db:push": "dotenv -e envs/.env.development -- prisma db push --schema packages/db/schema.prisma",
    "db:migrate": "dotenv -e envs/.env.development -- prisma migrate dev --schema packages/db/schema.prisma",
    "db:deploy": "dotenv -e envs/.env.production -- prisma migrate deploy --schema packages/db/schema.prisma",
    "db:seed": "dotenv -e envs/.env.development -- tsx packages/db/seed.ts",
    "seed:frameworks": "dotenv -e envs/.env.development -- tsx scripts/seed-frameworks.ts",
    "backfill:control-embeddings": "dotenv -e envs/.env.development -- tsx scripts/backfill-control-embeddings.ts",
    "seed:templates": "dotenv -e envs/.env.development -- tsx prisma/seed-templates.ts",
    "seed:plans": "dotenv -e envs/.env.development -- tsx packages/db/seed-plans.ts",
    "seed:all": "npm run db:seed && npm run seed:frameworks && npm run seed:templates && npm run seed:plans",
    "docker:up": "docker compose --env-file envs/.env.docker up -d",
    "docker:down": "docker compose --env-file envs/.env.docker down",
    "docker:logs": "docker compose logs -f nextjs",
    "docker:reset": "docker compose --env-file envs/.env.docker down -v && docker compose --env-file envs/.env.docker up -d --build",
    "db:test:setup": "./scripts/setup-test-db.sh",
    "db:clean:artifacts": "dotenv -e envs/.env.development -- tsx scripts/clean-test-artifacts.ts"
  },
  "prisma": {
    "seed": "tsx packages/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.1084.0",
    "@aws-sdk/client-config-service": "^3.1084.0",
    "@aws-sdk/client-rds": "^3.1079.0",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/client-sts": "^3.1084.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@node-saml/node-saml": "^5.1.0",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^5.16.2",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-query": "^5.51.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@types/pdf-parse": "^1.1.5",
    "ae-cvss-calculator": "^1.0.13",
    "archiver": "^8.0.0",
    "bullmq": "^5.79.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.10.0",
    "framer-motion": "^12.41.0",
    "handlebars": "^4.7.9",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.408.0",
    "minio": "^8.0.7",
    "next": "^14.2.4",
    "next-auth": "^4.24.7",
    "next-themes": "^0.3.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^7.0.7",
    "openid-client": "^5.7.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.4.0",
    "tesseract.js": "^7.0.0",
    "tiptap-markdown": "^0.9.0",
    "uuid": "^14.0.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.45.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/archiver": "^8.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/handlebars": "^4.0.40",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.43",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-dropzone": "^4.2.2",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.39",
    "prisma": "^5.16.2",
    "tailwindcss": "^3.4.7",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
