    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "panels": [],
      "title": "\ud83d\udd10 Authentication",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "title": "Authentication Attempts/sec by Status",
      "description": "auth_attempts_total, labelled {method,status} (src/lib/observability/metrics.ts). Splitting by status rather than charting a single total: a rising total is meaningless without knowing whether the extra attempts are succeeding.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(auth_attempts_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 46
      },
      "title": "Authentication Failure Rate",
      "description": "Proportion of attempts that fail. The AuthFailureSpike alert (monitoring/rules/dharma.yml) fires on the absolute failure rate; this panel gives the ratio, which is what distinguishes credential stuffing from an SSO certificate that expired and is failing every login.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(auth_attempts_total{status=\"failure\"}[5m])) / clamp_min(sum(rate(auth_attempts_total[5m])), 0.001)",
          "legendFormat": "failure ratio",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 54
      },
      "title": "Authentication Attempts by Method",
      "description": "Google OAuth vs email magic-link vs enterprise SSO. A method dropping to zero while the others continue is an integration failure, not a quiet period.",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method) (rate(auth_attempts_total[5m]))",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ]
    }
