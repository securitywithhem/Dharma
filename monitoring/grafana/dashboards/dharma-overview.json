      "title": "Ollama Service Health",
      "description": "probe_success from blackbox_exporter hitting ollama:11434/api/version \u2014 same signal as the app's health.checkAll.ollama check that drives the Compliance Advisor's degraded banner.",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"ollama_probe\"}",
          "legendFormat": "Ollama"
