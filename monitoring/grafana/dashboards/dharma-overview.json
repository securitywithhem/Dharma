      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(trpc_request_duration_ms_count[5m])) by (path, status)",
          "legendFormat": "{{path}} ({{status}})"
