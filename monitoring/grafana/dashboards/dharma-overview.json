      },
      "id": 7,
      "title": "tRPC Response Time (p95)",
      "description": "Requires OTEL_EXPORTER_OTLP_ENDPOINT set on nextjs/worker (see src/lib/observability/metrics.ts: trpc_request_duration_ms).",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(trpc_request_duration_ms_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}} p95"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
